  <wsdl:portType name="Journalbehandling">
    <wsdl:operation name="lagreDokumentOgOpprettJournalpost">
      <wsdl:documentation>&lt;p&gt;Operasjonen tilbyr å lagre dokument og metadata i arkivet og oppretter en journalpost tilknyttet dokumentet.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:lagreDokumentOgOpprettJournalpostRequest"/>
      <wsdl:output message="tns:lagreDokumentOgOpprettJournalpostResponse"/>
      <wsdl:fault message="tns:lagreDokumentOgOpprettJournalpostFault" name="lagreDokumentOgOpprettJournalpostFault"/>
      <wsdl:fault message="tns:lagreDokumentOgOpprettJournalpostFault1" name="lagreDokumentOgOpprettJournalpostFault1"/>
    </wsdl:operation>
    <wsdl:operation name="oppdaterJournal">
      <wsdl:documentation>&lt;p&gt;Operasjonen tilbyr å oppdatere dokument og metadata på en journal i arkivet.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:oppdaterJournalRequest"/>
      <wsdl:output message="tns:oppdaterJournalResponse"/>
      <wsdl:fault message="tns:oppdaterJournalFault" name="oppdaterJournalFault"/>
      <wsdl:fault message="tns:oppdaterJournalFault1" name="oppdaterJournalFault1"/>
      <wsdl:fault message="tns:oppdaterJournalFault2" name="oppdaterJournalFault2"/>
    </wsdl:operation>
    <wsdl:operation name="ferdigstillRedigerbartDokumentOgJournalpost">
      <wsdl:documentation>&lt;p&gt;Tjenesteoperasjonen lagrer dokumentet på en eksisterende journalpost endelig og ferdigstiller journalposten.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:ferdigstillRedigerbartDokumentOgJournalpostRequest"/>
      <wsdl:output message="tns:ferdigstillRedigerbartDokumentOgJournalpostResponse"/>
      <wsdl:fault message="tns:ferdigstillRedigerbartDokumentOgJournalpostFault" name="ferdigstillRedigerbartDokumentOgJournalpostFault"/>
      <wsdl:fault message="tns:ferdigstillRedigerbartDokumentOgJournalpostFault1" name="ferdigstillRedigerbartDokumentOgJournalpostFault1"/>
    </wsdl:operation>
    <wsdl:operation name="gjenbrukRedigerbartDokument">
      <wsdl:documentation>&lt;p&gt;Tjenesteoperasjonen kopierer et eksisterende redigerbart dokument, lagrer det i redigerbart tilstand og oppretter en journalpost på samme bruker, mottaker, sak og fagområde tilknyttet dokumentet.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:gjenbrukRedigerbartDokumentRequest"/>
      <wsdl:output message="tns:gjenbrukRedigerbartDokumentResponse"/>
      <wsdl:fault message="tns:gjenbrukRedigerbartDokumentFault" name="gjenbrukRedigerbartDokumentFault"/>
    </wsdl:operation>
    <wsdl:operation name="lagreRedigerbartDokumentOgOpprettJournalpost">
      <wsdl:documentation>&lt;p&gt;Tjenesteoperasjonen lagrer et nytt dokument og metadata i en redigerbar tilstand og oppretter en journalpost tilknyttet dokumentet.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:lagreRedigerbartDokumentOgOpprettJournalpostRequest"/>
      <wsdl:output message="tns:lagreRedigerbartDokumentOgOpprettJournalpostResponse"/>
    </wsdl:operation>
    <wsdl:operation name="mellomlagreRedigerbartDokument">
      <wsdl:documentation>&lt;p&gt;Tjenesteoperasjonen lagrer eksisterende redigerbart dokument på en journalpost i en redigerbar tilstand.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:mellomlagreRedigerbartDokumentRequest"/>
      <wsdl:output message="tns:mellomlagreRedigerbartDokumentResponse"/>
      <wsdl:fault message="tns:mellomlagreRedigerbartDokumentFault" name="mellomlagreRedigerbartDokumentFault"/>
    </wsdl:operation>
    <wsdl:operation name="kopierDokumentSomRedigerbartVedlegg">
      <wsdl:documentation>&lt;p&gt;Tjeneste for å opprette en journalstruktur for vedlegg samt lagre ned en vedleggsmal på en ny journalpost. Vedleggsmalen (i DLF-format) vil inneholde metadata som peker på det ferdigstilte dokumentet som ønskes kopiert som redigerbart vedlegg. Tjenesten tilrettelegger for at det redigerbare vedlegget kan kopieres til en ny journalpost.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:kopierDokumentSomRedigerbartVedleggRequest"/>
      <wsdl:output message="tns:kopierDokumentSomRedigerbartVedleggResponse"/>
      <wsdl:fault message="tns:kopierDokumentSomRedigerbartVedleggFault" name="kopierDokumentSomRedigerbartVedleggFault"/>
      <wsdl:fault message="tns:kopierDokumentSomRedigerbartVedleggFault1" name="kopierDokumentSomRedigerbartVedleggFault1"/>
    </wsdl:operation>
    <wsdl:operation name="ferdigstillRedigerbartVedlegg">
      <wsdl:documentation>&lt;p&gt;Tjeneste for å lagre et vedlegg på en eksisterende journalpost endelig.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:ferdigstillRedigerbartVedleggRequest"/>
      <wsdl:output message="tns:ferdigstillRedigerbartVedleggResponse"/>
      <wsdl:fault message="tns:ferdigstillRedigerbartVedleggFault" name="ferdigstillRedigerbartVedleggFault"/>
    </wsdl:operation>
    <wsdl:operation name="slettVedleggFraUtgaendeJournalpost">
      <wsdl:documentation>&lt;p&gt;Tjeneste for å slette et vedlegg på en utgående journalpost som er under arbeid.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:slettVedleggFraUtgaendeJournalpostRequest"/>
      <wsdl:output message="tns:slettVedleggFraUtgaendeJournalpostResponse"/>
      <wsdl:fault message="tns:slettVedleggFraUtgaendeJournalpostFault" name="slettVedleggFraUtgaendeJournalpostFault"/>
    </wsdl:operation>
    <wsdl:operation name="avbrytJournalpost">
      <wsdl:documentation>&lt;p&gt;Tjeneste for å avbryte en utgående journalpost så fremt den ikke er distrubert/under distribusjon.&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:avbrytJournalpostRequest"/>
      <wsdl:output message="tns:avbrytJournalpostResponse"/>
      <wsdl:fault message="tns:avbrytJournalpostFault" name="avbrytJournalpostFault"/>
    </wsdl:operation>
    <wsdl:operation name="avvikshandterOgDelDokument">
      <wsdl:documentation>&lt;p&gt;Tjeneste for å splitte og avvikshåndtere et dokument&lt;/p&gt; </wsdl:documentation>
      <wsdl:input message="tns:avvikshandterOgDelDokumentRequest"/>
      <wsdl:output message="tns:avvikshandterOgDelDokumentResponse"/>
      <wsdl:fault message="tns:avvikshandterOgDelDokumentFault" name="avvikshandterOgDelDokumentFault"/>
