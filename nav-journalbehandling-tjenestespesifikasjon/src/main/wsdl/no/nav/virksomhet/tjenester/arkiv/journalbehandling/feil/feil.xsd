<?xml version="1.0" encoding="UTF-8"?><xsd:schema targetNamespace="http://nav.no/virksomhet/tjenester/arkiv/journalbehandling/feil/v1" version="1.2" xmlns:feil="http://nav.no/virksomhet/tjenester/arkiv/journalbehandling/feil/v1" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <xsd:complexType name="StelvioFault">
    <xsd:sequence>
      <xsd:element minOccurs="0" name="errorMessage" type="xsd:string"/>
      <xsd:element minOccurs="0" name="errorSource" type="xsd:string"/>
      <xsd:element minOccurs="0" name="errorType" type="xsd:string"/>
      <xsd:element minOccurs="0" name="rootCause" type="xsd:string"/>
      <xsd:element minOccurs="0" name="dateTimeStamp" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="UgyldigDokumentInfoId">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;Oppgitt dokumentInfoId eksisterer ikke&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="UgyldigJournalstatus">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;For at tjenesteoperasjonen skal kunne utføres må journalposten være under arbeid, hvis ikke returneres en funksjonell feil. Dvs journalstatusKode på journalposten tilknyttet journalpostId må være lik ”D” (Under arbeid).&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="UgyldigStatusovergang">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;&lt;span style="font-size:11pt;font-family:Calibri;"&gt;Ulovlig overgang mellom gammel og ny journalstatus&lt;/span&gt;&lt;span style="font-size:11pt;font-family:Calibri;"&gt;&lt;/span&gt;&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="UgyldigJournalpostId">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;Oppgitt journalpostId eksisterer ikke&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="IkkeFerdigstiltVedlegg">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;Returneres dersom gitt journalpost inneholder vedlegg som er under redigering.&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="UgyldigJournalstatusPaJournalpostDetKopieresFra">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;Returneres når journalposten man forsøker å kopiere fra har journalstatus ulik "J" eller "FS" eller "FL" eller "E".&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="UgyldigJournalstatusPaJournalpostDetKopieresTil">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;Returneres når journalposten man forsøker å lagre et nytt vedlegg på har journalstatus ulik "D".&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="JournalpostUnderDistribusjonEllerDistribuert">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;Returneres når journalposten man forsøker å avbryte er under distribusjon eller er distribuert.&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:complexType name="UgyldigInput">
    <xsd:annotation>
      <xsd:documentation>&lt;p&gt;&lt;span style="font-size:11pt;font-family:Calibri;"&gt;Input inneholder ugyldige verdi(er)&lt;/span&gt;&lt;/p&gt;</xsd:documentation>
    </xsd:annotation>
    <xsd:complexContent>
      <xsd:extension base="feil:StelvioFault"/>
    </xsd:complexContent>
  </xsd:complexType>
</xsd:schema>